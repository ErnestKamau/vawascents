# Laravel API base URL. Use your machine's LAN IP for physical devices.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api

# OAuth client IDs from Google Cloud Console (same values go into
# backend/.env as a comma-separated GOOGLE_CLIENT_IDS).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google Cloud Console → APIs & Services → Credentials. Enable "Maps SDK for Android"
# on the same project, then restrict this key to that API + your app's package name.
# Required for the delivery pickup-point/tracking map to render on Android — without
# it GoogleMaps.View shows a blank/black tile area. Needs a native rebuild to take effect.
GOOGLE_MAPS_ANDROID_API_KEY=
